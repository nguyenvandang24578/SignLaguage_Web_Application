# Quiz Server Configuration

# "remote": Server nhận frame qua WebSocket (dùng cho production/VPS)
# "local": Server tự mở webcam, stream MJPEG (dùng cho dev/test)
CAMERA_MODE=remote

# Device inference: cuda | cpu | mps (mac)
# Mặc định server sẽ tự động nhận diện nếu không set
# DEVICE=cuda

# Host / Port
HOST=0.0.0.0
PORT=8000

# Chỉ dùng nếu CAMERA_MODE=local
CAMERA_SRC=1
